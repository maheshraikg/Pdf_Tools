  {"id": "w127", "tulu": "ಎನ್ನ ಪುದರ್ ...", "roman": "enna pudar ...", "kn": "ನನ್ನ ಹೆಸರು ...", "en": "My name is ...", "cat": "phrases"},
  {"id": "w128", "tulu": "ಬಲೆ ಕುಲ್ಲುಲೆ", "roman": "bale kullule", "kn": "ಬನ್ನಿ ಕುಳಿತುಕೊಳ್ಳಿ", "en": "Please come and sit", "cat": "phrases"},
  {"id": "w129", "tulu": "ನುಪ್ಪು ಆಂಡಾ?", "roman": "nuppu aandaa?", "kn": "ಊಟ ಆಯಿತಾ?", "en": "Have you eaten?", "cat": "phrases"},
  {"id": "w130", "tulu": "ಈರ್ ಓಲು ಪೋಪರ್?", "roman": "eer olu popar?", "kn": "ನೀವು ಎಲ್ಲಿಗೆ ಹೋಗುತ್ತೀರಿ?", "en": "Where are you going?", "cat": "phrases"},
  {"id": "w131", "tulu": "ಎಂಕ್ ಗೊತ್ತಿಜ್ಜಿ", "roman": "enk gottijji", "kn": "ನನಗೆ ಗೊತ್ತಿಲ್ಲ", "en": "I don't know", "cat": "phrases"},
  {"id": "w132", "tulu": "ಎಂಕ್ ತುಳು ಬರ್ಪುಂಡು", "roman": "enk tulu barpund", "kn": "ನನಗೆ ತುಳು ಬರುತ್ತದೆ", "en": "I know Tulu", "cat": "phrases"},
  {"id": "w133", "tulu": "ಒರ ಕೂಡ ಪನ್ಲೆ", "roman": "ora kooda panle", "kn": "ಇನ್ನೊಮ್ಮೆ ಹೇಳಿ", "en": "Please say it again", "cat": "phrases"},
  {"id": "w134", "tulu": "ಉಂದು ದಾದ?", "roman": "undu daada?", "kn": "ಇದು ಏನು?", "en": "What is this?", "cat": "phrases"},
  {"id": "w135", "tulu": "ಬಸ್ ಏಪ ಬರ್ಪುಂಡು?", "roman": "bas epa barpund?", "kn": "ಬಸ್ ಯಾವಾಗ ಬರುತ್ತದೆ?", "en": "When will the bus come?", "cat": "phrases"},
  {"id": "w136", "tulu": "ಒಂತೆ ಉಂತುಲೆ", "roman": "onte untule", "kn": "ಸ್ವಲ್ಪ ನಿಲ್ಲಿ", "en": "Please wait a little", "cat": "phrases"},
  {"id": "w137", "tulu": "ಮಸ್ತ್ ಎಡ್ಡೆ ಆತ್ಂಡ್", "roman": "mast edde aatnd", "kn": "ತುಂಬಾ ಚೆನ್ನಾಗಿದೆ", "en": "It's very good", "cat": "phrases"},
  {"id": "w138", "tulu": "ಎಡ್ಡೆ ಆವಡ್", "roman": "edde aavad", "kn": "ಒಳ್ಳೆಯದಾಗಲಿ", "en": "May good things happen", "cat": "phrases"},
  {"id": "w139", "tulu": "ಪೋದು ಬರ್ಪೆ", "roman": "podu barpe", "kn": "ಹೋಗಿ ಬರುತ್ತೇನೆ", "en": "Goodbye (I'll go and come back)", "cat": "phrases"},
  {"id": "w140", "tulu": "ದಾನೆ?", "roman": "daane?", "kn": "ಏನು?", "en": "What? / What's up?", "cat": "phrases"}
 ]
