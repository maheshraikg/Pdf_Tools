  {"id": "w131", "tulu": "ಎಂಕ್ ಗೊತ್ತಿಜ್ಜಿ", "roman": "enk gottijji", "kn": "ನನಗೆ ಗೊತ್ತಿಲ್ಲ", "en": "I don't know", "cat": "phrases"},
