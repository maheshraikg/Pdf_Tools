# ---------------------------------------------------------------------------
# Quiz Competition Platform — environment configuration
# Copy to .env (never commit real secrets). All keys below marked "secret"
# must be generated per deployment and stored in your secret manager.
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
NODE_ID=                     # unique per instance (defaults to PID)
TRUST_PROXY=true             # true behind nginx / a cloud load balancer
PUBLIC_ORIGIN=https://quiz.example.org
LOG_LEVEL=info
COOKIE_SECURE=true
MIGRATE_ON_START=false       # run `npm run migrate` as a release step instead

# Database / cache
DATABASE_URL=postgres://quiz:CHANGE_ME@db:5432/quiz
DB_POOL_MAX=30               # per instance; keep instances × pool < Postgres max_connections (or use PgBouncer)
REDIS_URL=redis://redis:6379 # required when running more than one instance

# 32-byte keys, base64 (secret). Generate each with: openssl rand -base64 32
# Rotating PHONE_HASH_KEY / PHONE_ENC_KEY requires re-keying existing users.
PHONE_HASH_KEY=
PHONE_ENC_KEY=
OTP_HMAC_KEY=
IP_HASH_KEY=
ACCESS_CODE_KEY=

DEFAULT_COUNTRY_CODE=91

# OTP policy
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_PHONE_PER_HOUR=5
OTP_MAX_SENDS_PER_IP_PER_HOUR=30   # raise for venues where many participants share one network
OTP_MAX_VERIFY_FAILURES_PER_PHONE_PER_HOUR=10

# SMS gateway: twilio | msg91   ("console" is development-only and refused in production)
SMS_PROVIDER=msg91
SMS_SENDER_ID=QUIZAP
# MSG91 (India, DLT templates). The OTP template must contain the variable ##otp##.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_NOTIFY_TEMPLATE_ID=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Sessions
USER_SESSION_TTL_HOURS=168
ADMIN_SESSION_TTL_HOURS=8
SESSION_IDLE_TIMEOUT_HOURS=72

# Abuse protection (per client IP — remember that schools / carriers share IPs)
RATE_LIMIT_GLOBAL_PER_IP_PER_MINUTE=600
RATE_LIMIT_SUBMIT_PER_USER_PER_MINUTE=40
RATE_LIMIT_ADMIN_LOGIN_PER_IP_PER_15MIN=10

# Notifications
NOTIFICATIONS_SMS_ENABLED=false
NOTIFY_STARTING_SOON_MINUTES=15
NOTIFY_SMS_BATCH_SIZE=50

# Background jobs (safe to run on every instance)
JOBS_ENABLED=true
LIFECYCLE_INTERVAL_MS=500
FINALIZE_GRACE_MS=2000
PROVISIONAL_LEADERBOARD_INTERVAL_MS=3000

# Protect /metrics in production
METRICS_TOKEN=

# Load testing only — leave EMPTY in production (ignored when NODE_ENV=production)
LOAD_TEST_SECRET=
