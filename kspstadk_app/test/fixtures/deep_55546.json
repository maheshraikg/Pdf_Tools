portant; box-shadow: 0 1px 2px rgba(0,0,0,0.05) !important;\" placeholder=\"ಮಕ್ಕಳ ಸಂಖ್ಯೆ\">\n        </div>\n        <div style=\"display: flex !important; gap: 12px !important;\">\n            <button type=\"button\" class=\"mdm-interactive-btn btn-calc\" onclick=\"runMdmAppEngine()\" style=\"background-color: #2563eb !important; color: #ffffff !important; border: none !important; padding: 10px 22px !important; border-radius: 8px !important; font-weight: 700 !important; font-size: 13.5px !important; cursor: pointer !important; box-shadow: 0 4px 6px -1px rgba(37, 99, 243, 0.2) !important;\">📊 ಲೆಕ್ಕ ಹಾಕಿ</button>\n            <button type=\"button\" class=\"mdm-interactive-btn btn-print\" onclick=\"window.focus(); window.print();\" style=\"background-color: #16a34a !important; color: #ffffff !important; border: none !important; padding: 10px 22px !important; border-radius: 8px !important; font-weight: 700 !important; font-size: 13.5px !important; cursor: pointer !important; box-shadow: 0 4px 6px -1px rgba(22, 163, 74, 0.2) !important;\">🖨️ Print</button>\n        </div>\n    </div>\n\n    <!-- Official Polished Master Data Register Table -->\n    <div style=\"overflow-x: auto !important; width: 100% !important;\">\n        <table style=\"width: 100% !important; min-width: 500px !important; border-collapse: collapse !important; border: 1px solid #cbd5e1 !important; border-radius: 10px !important; overflow: hidden !important; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02) !important;\">\n            <thead>\n                <tr style=\"background-color: #7c2d12 !important; color: #ffffff !important; font-weight: 700 !important;\">\n                    <th style=\"padding: 14px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; width: 10% !important; font-size: 13.5px !important; letter-spacing: 0.5px !important;\">ಕ್ರಮ</th>\n                    <th style=\"padding: 14px 14px !important; border: 1px solid #cbd5e1 !important; text-align: left !important; padding-left: 24px !important; width: 34% !important; font-size: 13.5px !important; letter-spacing: 0.5px !important;\">ಅಂಶ</th>\n                    <th style=\"padding: 14px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; width: 18% !important; font-size: 13.5px !important; letter-spacing: 0.5px !important;\">1–5</th>\n                    <th style=\"padding: 14px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; width: 18% !important; font-size: 13.5px !important; letter-spacing: 0.5px !important;\">6–10</th>\n                    <th style=\"padding: 14px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; width: 20% !important; font-size: 13.5px !important; letter-spacing: 0.5px !important;\">ಒಟ್ಟು</th>\n                </tr>\n            </thead>\n            <tbody style=\"background-color: #ffffff !important;\">\n                <tr class=\"mdm-table-row\">\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #64748b !important; font-weight: 500 !important;\">1</td>\n                    <td style=\"padding: 11px 14px !important; border: 1px solid #cbd5e1 !important; text-align: left !important; font-weight: 700 !important; color: #1e293b !important; padding-left: 24px !important;\">ಅಕ್ಕಿ</td>\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #334155 !important;\" id=\"val_rice_lp\">0 ಗ್ರಾಂ</td>\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #334155 !important;\" id=\"val_rice_up\">0 ಗ್ರಾಂ</td>\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; font-weight: 700 !important; color: #0f172a !important;\" id=\"val_rice_tot\">0 ಗ್ರಾಂ</td>\n                </tr>\n                <tr class=\"mdm-table-row\">\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #64748b !important; font-weight: 500 !important;\">2</td>\n                    <td style=\"padding: 11px 14px !important; border: 1px solid #cbd5e1 !important; text-align: left !important; font-weight: 700 !important; color: #1e293b !important; padding-left: 24px !important;\">ಬೇಳೆ</td>\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #334155 !important;\" id=\"val_dhal_lp\">0 ಗ್ರಾಂ</td>\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #334155 !important;\" id=\"val_dhal_up\">0 ಗ್ರಾಂ</td>\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; font-weight: 700 !important; color: #0f172a !important;\" id=\"val_dhal_tot\">0 ಗ್ರಾಂ</td>\n                </tr>\n                <tr class=\"mdm-table-row\">\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #64748b !important; font-weight: 500 !important;\">3</td>\n                    <td style=\"padding: 11px 14px !important; border: 1px solid #cbd5e1 !important; text-align: left !important; font-weight: 700 !important; color: #1e293b !important; padding-left: 24px !important;\">ಎಣ್ಣೆ</td>\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #334155 !important;\" id=\"val_oil_lp\">0 ಗ್ರಾಂ</td>\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #334155 !important;\" id=\"val_oil_up\">0 ಗ್ರಾಂ</td>\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; font-weight: 700 !important; color: #0f172a !important;\" id=\"val_oil_tot\">0 ಗ್ರಾಂ</td>\n                </tr>\n                <tr class=\"mdm-table-row\">\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #64748b !important; font-weight: 500 !important;\">4</td>\n                    <td style=\"padding: 11px 14px !important; border: 1px solid #cbd5e1 !important; text-align: left !important; font-weight: 700 !important; color: #1e293b !important; padding-left: 24px !important;\">ಉಪ್ಪು</td>\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #334155 !important;\" id=\"val_salt_lp\">0 ಗ್ರಾಂ</td>\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #334155 !important;\" id=\"val_salt_up\">0 ಗ್ರಾಂ</td>\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; font-weight: 700 !important; color: #0f172a !important;\" id=\"val_salt_tot\">0 ಗ್ರಾಂ</td>\n                </tr>\n                <tr class=\"mdm-table-row\">\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #64748b !important; font-weight: 500 !important;\">5</td>\n                    <td style=\"padding: 11px 14px !important; border: 1px solid #cbd5e1 !important; text-align: left !important; font-weight: 700 !important; color: #1e293b !important; padding-left: 24px !important;\">ತರಕಾರಿ</td>\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #334155 !important;\" id=\"val_veg_lp\">0 ಗ್ರಾಂ</td>\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #334155 !important;\" id=\"val_veg_up\">0 ಗ್ರಾಂ</td>\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; font-weight: 700 !important; color: #0f172a !important;\" id=\"val_veg_tot\">0 ಗ್ರಾಂ</td>\n                </tr>\n                <tr class=\"mdm-table-row\">\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #64748b !important; font-weight: 500 !important;\">6</td>\n                    <td style=\"padding: 11px 14px !important; border: 1px solid #cbd5e1 !important; text-align: left !important; font-weight: 700 !important; color: #1e293b !important; padding-left: 24px !important;\">ಹಾಲು</td>\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #334155 !important;\" id=\"val_milk_lp\">0 ಗ್ರಾಂ</td>\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #334155 !important;\" id=\"val_milk_up\">0 ಗ್ರಾಂ</td>\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; font-weight: 700 !important; color: #0f172a !important;\" id=\"val_milk_tot\">0 ಗ್ರಾಂ</td>\n                </tr>\n                <tr class=\"mdm-table-row\">\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #64748b !important; font-weight: 500 !important;\">7</td>\n                    <td style=\"padding: 11px 14px !important; border: 1px solid #cbd5e1 !important; text-align: left !important; font-weight: 700 !important; color: #1e293b !important; padding-left: 24px !important;\">ಸಕ್ಕರೆ</td>\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #334155 !important;\" id=\"val_sugar_lp\">0 ಗ್ರಾಂ</td>\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #334155 !important;\" id=\"val_sugar_up\">0 ಗ್ರಾಂ</td>\n                    <td style=\"padding: 11px 10px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; font-weight: 700 !important; color: #0f172a !important;\" id=\"val_sugar_tot\">0 ಗ್ರಾಂ</td>\n                </tr>\n\n                <!-- Traditional Yellow Operational Cost Matrix Row -->\n                <tr style=\"background-color: #ffedd5 !important; font-weight: bold !important;\">\n                    <td colspan=\"2\" style=\"padding: 16px 20px !important; border: 1px solid #cbd5e1 !important; color: #9a3412 !important; font-size: 13px !important; line-height: 1.6 !important; text-align: center !important;\">\n                        ಬೇಳೆ, ತರಕಾರಿ, ಎಣ್ಣೆ, ಉಪ್ಪು, ಇಂಧನ ಸಾಂಬಾರ್‌ ಪದಾರ್ಥ ಮತ್ತು ಇತರೆ ವೆಚ್ಚ ಪರಿವರ್ತನಾ ವೆಚ್ಚ CG ವೆಚ್ಚ\n                    </td>\n                    <td style=\"padding: 16px 8px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #c2410c !important; font-size: 15px !important;\" id=\"cost_lp\">₹0.00</td>\n                    <td style=\"padding: 16px 8px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #c2410c !important; font-size: 15px !important;\" id=\"cost_up\">₹0.00</td>\n                    <td style=\"padding: 16px 8px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; color: #9a3412 !important; font-size: 16px !important;\" id=\"cost_tot\">₹0.00</td>\n                </tr>\n\n                <!-- Traditional Green Total Attendance Row Summary -->\n                <tr style=\"background-color: #d1fae5 !important; font-weight: bold !important; color: #065f46 !important;\">\n                    <td colspan=\"2\" style=\"padding: 14px 8px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; font-size: 14px !important;\">ಒಟ್ಟು ವಿದ್ಯಾರ್ಥಿಗಳು</td>\n                    <td style=\"padding: 14px 8px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; font-size: 15px !important;\" id=\"summary_count_lp\">0</td>\n                    <td style=\"padding: 14px 8px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; font-size: 15px !important;\" id=\"summary_count_up\">0</td>\n                    <td style=\"padding: 14px 8px !important; border: 1px solid #cbd5e1 !important; text-align: center !important; font-size: 16px !important; color: #047857 !important;\" id=\"summary_count_tot\">0</td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n</div>\n\n<!-- EXTERNAL GLOBAL RESPONSIVE RULES OVERLAY (FOR CELLPHONES) -->\n<style>\n/* Dynamic Responsive Controls for Smartphones */\n@media screen and (max-width: 600px) {\n    .mdm-standalone-app { padding: 12px !important; margin: 10px auto !important; border-radius: 12px !important; }\n    div[style*=\"background-color: #fce762\"], div[style*=\"background: linear-gradient\"] { padding: 14px 10px !important; gap: 12px !important; flex-direction: column !important; }\n    input[type=\"number\"] { width: 100% !important; max-width: 100% !important; box-sizing: border-box !important; padding: 10px !important; }\n    .mdm-interactive-btn { width: 100% !important; padding: 11px !important; }\n}\n\n/* Flawless Physical Sheet Printer Mapping System */\n@media print {\n    .mdm-no-print { display: none !important; }\n    body * { visibility: hidden !important; }\n    .mdm-standalone-app, .mdm-standalone-app * { visibility: visible !important; }\n    .mdm-standalone-app { position: absolute !important; left: 0 !important; top: 0 !important; width: 100% !important; border: none !important; box-shadow: none !important; padding: 0 !important; margin: 0 !important; }\n    table { border: 2px solid #000 !important; width: 100% !important; min-width: 100% !important; }\n    th, td { border: 1px solid #000 !important; color: #000 !important; background: transparent !important; padding: 10px !important; font-size: 13px !important; }\n}\n</style>\n\n<!-- RUNTIME JAVASCRIPT MOTOR ENGINE -->\n<script>\nfunction runMdmAppEngine() {\n    var lpInput = document.getElementById('attendance_primary').value;\n    var upInput = document.getElementById('attendance_upper').value;\n    \n    var lpCount = parseInt(lpInput) || 0;\n    var upCount = parseInt(upInput) || 0;\n\n    var normMatrix = {\n        rice:  { lp: 100, up: 150 },\n        dhal:  { lp: 20,  up: 30 },\n        oil:   { lp: 5,   up: 7.5 },\n        salt:  { lp: 2,   up: 4 }, \n        veg:   { lp: 50,  up: 75 },\n        milk:  { lp: 18,  up: 18 },\n        sugar: { lp: 10,  up: 10 }\n    };\n\n    function formatUnit(grams) {\n        if (grams >= 1000) {\n            return (grams / 1000).toFixed(2) + \" ಕೆ.ಜಿ.\";\n        }\n        return grams + \" ಗ್ರಾಂ\";\n    }\n\n    var itemKeys = ['rice', 'dhal', 'oil', 'salt', 'veg', 'milk', 'sugar'];\n    itemKeys.forEach(function(item) {\n        var lpGrams = lpCount * normMatrix[item].lp;\n        var upGrams = upCount * normMatrix[item].up;\n        var totGrams = lpGrams + upGrams;\n\n        document.getElementById('val_' + item + '_lp').innerText  = formatUnit(lpGrams);\n        document.getElementById('val_' + item + '_up').innerText  = formatUnit(upGrams);\n        document.getElementById('val_' + item + '_tot').innerText = formatUnit(totGrams);\n    });\n\n    var lpCostRate = 6.78; \n    var upCostRate = 10.17; \n\n    var finalLpCost  = lpCount * lpCostRate;\n    var finalUpCost  = upCount * upCostRate;\n    var finalTotCost = finalLpCost + finalUpCost;\n\n    document.getElementById('cost_lp').innerText  = \"₹\" + finalLpCost.toFixed(2);\n    document.getElementById('cost_up').innerText  = \"₹\" + finalUpCost.toFixed(2);\n    document.getElementById('cost_tot').innerText = \"₹\" + finalTotCost.toFixed(2);\n\n    document.getElementById('summary_count_lp').innerText  = lpCount;\n    document.getElementById('summary_count_up').innerText  = upCount;\n    document.getElementById('summary_count_tot').innerText = lpCount + upCount;\n}\n</script>\n\n</style>\n\n<script data-wp-block-html=\"js\">\nfunction runMdmAppEngine() {\n    var lpInput = document.getElementById('attendance_primary').value;\n    var upInput = document.getElementById('attendance_upper').value;\n    \n    var lpCount = parseInt(lpInput) || 0;\n    var upCount = parseInt(upInput) || 0;\n\n    var normMatrix = {\n        rice:  { lp: 100, up: 150 },\n        dhal:  { lp: 20,  up: 30 },\n        oil:   { lp: 5,   up: 7.5 },\n        salt:  { lp: 2,   up: 4 }, \n        veg:   { lp: 50,  up: 75 },\n        milk:  { lp: 18,  up: 18 },\n        sugar: { lp: 10,  up: 10 }\n    };\n\n    function formatUnit(grams) {\n        if (grams >= 1000) {\n            return (grams / 1000).toFixed(2) + \" ಕೆ.ಜಿ.\";\n        }\n        return grams + \" ಗ್ರಾಂ\";\n    }\n\n    var itemKeys = ['rice', 'dhal', 'oil', 'salt', 'veg', 'milk', 'sugar'];\n    itemKeys.forEach(function(item) {\n        var lpGrams = lpCount * normMatrix[item].lp;\n        var upGrams = upCount * normMatrix[item].up;\n        var totGrams = lpGrams + upGrams;\n\n        document.getElementById('val_' + item + '_lp').innerText  = formatUnit(lpGrams);\n        document.getElementById('val_' + item + '_up').innerText  = formatUnit(upGrams);\n        document.getElementById('val_' + item + '_tot').innerText = formatUnit(totGrams);\n    });\n\n    var lpCostRate = 6.78; \n    var upCostRate = 10.17; \n\n    var finalLpCost  = lpCount * lpCostRate;\n    var finalUpCost  = upCount * upCostRate;\n    var finalTotCost = finalLpCost + finalUpCost;\n\n    document.getElementById('cost_lp').innerText  = \"₹\" + finalLpCost.toFixed(2);\n    document.getElementById('cost_up').innerText  = \"₹\" + finalUpCost.toFixed(2);\n    document.getElementById('cost_tot').innerText = \"₹\" + finalTotCost.toFixed(2);\n\n    document.getElementById('summary_count_lp').innerText  = lpCount;\n    document.getElementById('summary_count_up').innerText  = upCount;\n    document.getElementById('summary_count_tot').innerText = lpCount + upCount;\n}\n\n// Add event listener directly to bypass inline restrictions\ndocument.addEventListener('DOMContentLoaded', function() {\n    document.querySelector('.btn-print').addEventListener('click', function() {\n        window.print();\n    });\n});\n\n</script>\n\n<div class=\"mdm-standalone-app\" style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important; max-width: 780px !important; margin: 25px auto !important; padding: 24px !important; background-color: #ffffff !important; border-radius: 16px !important; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05) !important; border: 1px solid #e2e8f0 !important; box-sizing: border-box !important;\">\n\n    <!-- Top Premium Slate Navy Header Title Banner -->\n    <div class=\"mdm-no-print\" style=\"background: linear-gradient(135deg, #0f172a, #1e3a8a) !important; color: #ffffff !important; font-weight: 700 !important; font-size: 16px !important; text-align: center !important; padding: 16px !important; border-radius: 10px !important; margin-bottom: 20px !important; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.12) !important; letter-spacing: 0.3px !important;\">\n        🍱 ಮಧ್ಯಾಹ್ನದ ಉಪಾಹಾರ ಯೋಜನೆ &#8211; ಪ್ರತಿನಿತ್ಯ ಲೆಕ್ಕಾಚಾರ\n    </div>\n\n    <!-- Soft Gold Control Panel (Responsive Flex Grid Layout) -->\n    <div class=\"mdm-no-print\" style=\"background: linear-gradient(135deg, #fef9c3, #fef08a) !imp