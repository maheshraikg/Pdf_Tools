ew\" width=\"640\" height=\"480\" allow=\"autoplay\"></iframe>\n\n\n<div style=\"gap: 20px\" class=\"align-button-center ub-buttons orientation-button-row ub-flex-wrap wp-block-ub-button\" id=\"ub-button-73ec8691-12c2-43b3-a6b4-bc28465c01cd\"><div class=\"ub-button-container\">\n\t\t\t<a href=\"https://kspstadk.com/public-exam-2/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"ub-button-block-main   ub-button-flex\" role=\"button\" style=\"--ub-button-background-color: #ba2354; --ub-button-color: #ffffff; --ub-button-border: none; --ub-button-hover-background-color: var(--accent-2); --ub-button-hover-color: #ffffff; --ub-button-hover-border: none; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; border-radius: 10px; \">\n\t\t\t\t<div class=\"ub-button-content-holder\" style=\"flex-direction: row\">\n\t\t\t\t\t<span class=\"ub-button-icon-holder\">\n\t\t\t\t<svg xmlns=\"http://www.w3.org/2000/svg\" height=\"40\" width=\"40\" viewbox=\"0 0 512 512\">\n\t\t\t\t\t<path fill=\"currentColor\" d=\"M256 0a256 256 0 1 0 0 512A256 256 0 1 0 256 0zM376.9 294.6L269.8 394.5c-3.8 3.5-8.7 5.5-13.8 5.5s-10.1-2-13.8-5.5L135.1 294.6c-4.5-4.2-7.1-10.1-7.1-16.3c0-12.3 10-22.3 22.3-22.3l57.7 0 0-96c0-17.7 14.3-32 32-32l32 0c17.7 0 32 14.3 32 32l0 96 57.7 0c12.3 0 22.3 10 22.3 22.3c0 6.2-2.6 12.1-7.1 16.3z\">\n\t\t\t\t</path></svg>\n\t\t\t</span><span class=\"ub-button-block-btn\"><strong> 5 ಮತ್ತು 8 ನೇ ತರಗತಿಯ ವಾರ್ಷಿಕ ಪರೀಕ್ಷೆಯ ಮಾದರಿ ಪ್ರಶ್ನೆ ಪತ್ರಿಕೆಗಳ ಮಾಹಿತಿ </strong></span>\n\t\t\t\t</div>\n\t\t\t</a>\n\t\t</div></div>\n\n\n<p class=\"has-text-align-center wp-block-paragraph\"><strong>ಪರಿಷ್ಕೃತ ವೇಳಾಪಟ್ಟಿ </strong></p>\n\n\n\n<div id=\"affiliate-style-50adc310-adf1-4d45-b79b-7acb525311bc\" class=\"affiliate-block-undefined affiliate-notification-wrapper\"><div class=\"affiliate-notification-inner\"><p class=\"affiliate-notification-content\" id=\"notice-50adc310-adf1-4d45-b79b-7acb525311bc\">2022-23 ನೇ ಸಾಲಿನ ಸರ್ಕಾರಿ ಶಾಲೆಗಳಲ್ಲಿ 5 ರಿಂದ 10ನೇ ತರಗತಿಯಲ್ಲಿ ಅಭ್ಯಾಸ ಮಾಡುತ್ತಿರುವ ವಿದ್ಯಾರ್ಥಿಗಳಲ್ಲಿ ಗಣಿತ, ವಿಜ್ಞಾನ, ತಂತ್ರಜ್ಞಾನ, ಭಾಷೆ, ದೇಶದಸಂಸ್ಕೃತಿ, ಪರಂಪರೆ, ಸಾಮಾನ್ಯ ಜ್ಞಾನ ಹಾಗೂ ಇತರ ವಿಷಯಗಳಲ್ಲಿ ಅರಿವಿನ ಮಟ್ಟವನ್ನು ಹೆಚ್ಚಿಸಲು ವಿದ್ಯಾರ್ಥಿಗಳಿಗೆ ಕಿರಿಯ ಹಾಗೂ ಹಿರಿಯರ ವಿಭಾಗ ಮಟ್ಟದಲ್ಲಿ ರಸಪ್ರಶ್ನೆ ಸ್ಪರ್ಧೆಯನ್ನು (Quiz Competition)ಆನ್ ಲೈನ್ ಮೂಲಕ ಆಯೋಜಿಸುವ ಸಂಬಂಧ ಉಲ್ಲೇಖಿತ ಪತ್ರದ ಸುತ್ತೋಲೆಯಲ್ಲಿ ವಿವರವಾಗಿ ಮಾಹಿತಿ ನೀಡಲಾಗಿತ್ತು. ಆದರೆ ಕೆಲವು ಜಿಲ್ಲೆಗಳಲ್ಲಿ ಶಾಲಾ ಹಂತದಲ್ಲಿ ಶಿಕ್ಷಕರು ವೇಳಾಪಟ್ಟಿಯಂತೆ ರಸಪ್ರಶ್ನೆಸ್ಪರ್ಧೆಯನ್ನು ನಡೆಸಿ ವಿಜೇತ ವಿದ್ಯಾರ್ಥಿಗಳ ಮಾಹಿತಿಯನ್ನು ವಿದ್ಯಾವಾಹಿನಿ ವೆಬ್ ಸೈಟ್ ನಲ್ಲಿ ಅಪ್ ಲೋಡ್ ಮಾಡಿರುವುದಿಲ್ಲ. ಈ ಹಿನ್ನೆಲೆಯಲ್ಲಿ ರಸಪ್ರಶ್ನೆ  ಸ್ಫರ್ಧೆ ಕಾರ್ಯಕ್ರಮದ ವೇಳಾಪಟ್ಟಿಯನ್ನು ಮರು ನಿಗದಿಗೊಳಿಸಲಾಗಿದೆ.</p></div></div>\n\n\n\n<div class=\"wp-block-group\"><div class=\"wp-block-group__inner-container is-layout-constrained wp-block-group-is-layout-constrained\"><div class=\"wp-block-image is-style-default\">\n<figure class=\"aligncenter size-full\"><img loading=\"lazy\" decoding=\"async\" width=\"720\" height=\"955\" src=\"https://kspstadk.com/wp-content/uploads/2023/02/IMG-20230203-WA0049.jpg\" alt=\"\" class=\"wp-image-25116\" srcset=\"https://kspstadk.com/wp-content/uploads/2023/02/IMG-20230203-WA0049.jpg 720w, https://kspstadk.com/wp-content/uploads/2023/02/IMG-20230203-WA0049-226x300.jpg 226w, https://kspstadk.com/wp-content/uploads/2023/02/IMG-20230203-WA0049-150x199.jpg 150w\" sizes=\"auto, (max-width: 720px) 100vw, 720px\" /></figure>\n</div></div></div>\n\n\n<div class=\"wp-block-image is-style-default\">\n<figure class=\"aligncenter size-large is-resized\"><img loading=\"lazy\" decoding=\"async\" src=\"https://kspstadk.com/wp-content/uploads/2023/02/IMG-20230203-WA0048-661x1024.jpg\" alt=\"\" class=\"wp-image-25117\" width=\"618\" height=\"958\" srcset=\"https://kspstadk.com/wp-content/uploads/2023/02/IMG-20230203-WA0048-661x1024.jpg 661w, https://kspstadk.com/wp-content/uploads/2023/02/IMG-20230203-WA0048-194x300.jpg 194w, https://kspstadk.com/wp-content/uploads/2023/02/IMG-20230203-WA0048-150x232.jpg 150w, https://kspstadk.com/wp-content/uploads/2023/02/IMG-20230203-WA0048.jpg 715